# Copy to .env and replace every CHANGE_ME value before starting Production.
DB_USERNAME=supplypilot_app
DB_PASSWORD=CHANGE_ME_PRODUCTION_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_PRODUCTION_MYSQL_ROOT_PASSWORD
# MySQL Workbench host port, bound to 127.0.0.1; container port remains 3306.
PRODUCTION_MYSQL_HOST_PORT=13306

SEMANTIC_DB_USERNAME=supplypilot_app
SEMANTIC_DB_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD

# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_32_BYTE_BASE64_SECRET
JWT_EXPIRATION_SECONDS=3600
FRONTEND_ORIGIN=http://127.0.0.1:8080

AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_PROVIDER_TIMEOUT=15s
AI_MONTHLY_TOKEN_WARNING_ENABLED=false
SEMANTIC_DIMENSIONS=768
SEMANTIC_GENERATION_KEY=gemini-embedding-001-768-v1
SEMANTIC_READ_ENABLED=false
