# Copy to .env.demo and keep this file private. Use credentials separate from .env.
DB_USERNAME=supplypilot_demo_app
DB_PASSWORD=CHANGE_ME_DEMO_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DEMO_MYSQL_ROOT_PASSWORD
# MySQL Workbench host port, bound to 127.0.0.1; container port remains 3306.
DEMO_MYSQL_HOST_PORT=13307

SEMANTIC_DB_USERNAME=supplypilot_demo_app
SEMANTIC_DB_PASSWORD=CHANGE_ME_DEMO_POSTGRES_PASSWORD

# Generate a separate random 32-byte Base64 value from Production.
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_32_BYTE_BASE64_SECRET
JWT_EXPIRATION_SECONDS=3600
DEMO_ACCOUNT_PASSWORD='CHANGE_ME_DEMO_BASELINE_PASSWORD'
DEMO_FRONTEND_PORT=8081
FRONTEND_ORIGIN=http://127.0.0.1:8081

AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_PROVIDER_TIMEOUT=15s
AI_MONTHLY_TOKEN_WARNING_ENABLED=false
SEMANTIC_DIMENSIONS=768
SEMANTIC_GENERATION_KEY=gemini-embedding-001-768-spring-ai-chunk500-overlap70-v2
SEMANTIC_INDEX_WORKER_ENABLED=true
SEMANTIC_READ_ENABLED=false
SEMANTIC_TOP_K=8
SEMANTIC_SIMILARITY_THRESHOLD=0.4
DOCUMENT_RAG_CHUNK_SIZE=500
DOCUMENT_RAG_CHUNK_OVERLAP_CHARACTERS=70
DEMO_DATASET_VERSION=sp-907-zh-tw-v3
DEMO_DATASET_UPGRADE_MODE=AUTO_SAFE
DEMO_DATASET_UPGRADE_CONFIRMATION=
DEMO_DATASET_UPGRADE_PLAN_SHA256=
